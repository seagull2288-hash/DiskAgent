# Python caches, environments and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.venv-mcp/
venv/
env/
.vscode/
.idea/

# Machine-specific paths: copy the tracked example on a new checkout.
/python_control/optimization_config.json

# Credentials belong in the configured user environment variable.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
**/credentials.json
**/secrets.json
**/config.*.local.json

# Runtime history is retained on disk, outside Git history.
/llm_runs/
/python_llm_runs/
/agent_workflows/
/agent_plans/
/agent_app_logs/
/agent_jobs/
/agent_chats/

# Transient logs, locks, temporary files and backups
*.log
*.lock
*.lck
*.pid
*.tmp
*.bak
*.wbpj~
Thumbs.db
Desktop.ini
.DS_Store

# Retain CAD and Workbench source databases; omit session/cache artefacts.
/project_v2/**/session_files/
/project_v2/**/.project_cache
/project_v2/**/user_files/DesignPointLog.csv

# Solver products that may later be created inside the Workbench project.
/project_v2/**/*.rst
/project_v2/**/*.rth
/project_v2/**/*.full
/project_v2/**/*.emat
/project_v2/**/*.esav
/project_v2/**/*.osav
/project_v2/**/*.mode
/project_v2/**/*.rdb
/project_v2/**/*.ldhi
/project_v2/**/*.db
/project_v2/**/*.err
/project_v2/**/*.out
/project_v2/**/ds.dat

# Verified modal project source; generated solver products stay local.
/project_modal/**/session_files/
/project_modal/**/.project_cache
/project_modal/**/user_files/DesignPointLog.csv
/project_modal/**/*.r[0-9][0-9][0-9]
/project_modal/**/*.DSP
/project_modal/**/*.mntr
/project_modal/**/CAERepOutput.xml
/project_modal/**/*.rst
/project_modal/**/*.rth
/project_modal/**/*.full
/project_modal/**/*.emat
/project_modal/**/*.esav
/project_modal/**/*.osav
/project_modal/**/*.mode
/project_modal/**/*.rdb
/project_modal/**/*.ldhi
/project_modal/**/*.db
/project_modal/**/*.err
/project_modal/**/*.out
/project_modal/**/ds.dat
